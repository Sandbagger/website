#!/usr/bin/env bash
# Verify the durable-host contract immediately before a Kamal action.
set -euo pipefail

if [[ -z "${KAMAL_HOST:-}" ]]; then
  echo "error=missing_kamal_host" >&2
  exit 1
fi

if [[ -z "${APP_SHARED_ROOT:-}" ]]; then
  echo "error=missing_app_shared_root" >&2
  exit 1
fi

if [[ ! "$APP_SHARED_ROOT" =~ ^/srv/apps/[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?/shared$ ]]; then
  echo "error=invalid_app_shared_root" >&2
  exit 1
fi

allow_root_disk_storage=0
if [[ "${ALLOW_ROOT_DISK_STORAGE:-}" == '1' ]]; then
  allow_root_disk_storage=1
fi

ssh_stderr=$(mktemp)
trap 'rm -f "$ssh_stderr"' EXIT

if env -u KAMAL_REGISTRY_PASSWORD -u RAILS_MASTER_KEY \
  ssh "root@$KAMAL_HOST" bash -s -- \
  "$APP_SHARED_ROOT" "$allow_root_disk_storage" 2>"$ssh_stderr" <<'REMOTE'
set -euo pipefail

fail() {
  echo "error=$1" >&2
  exit 1
}

[[ $# == 2 ]] || fail invalid_preflight_arguments
app_shared_root=$1
allow_root_disk_storage=$2
[[ "$app_shared_root" =~ ^/srv/apps/[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?/shared$ ]] ||
  fail invalid_app_shared_root
[[ "$allow_root_disk_storage" == 0 || "$allow_root_disk_storage" == 1 ]] ||
  fail invalid_root_disk_storage
app_root=${app_shared_root%/shared}
app_name=${app_root##*/}

command -v python3 >/dev/null 2>&1 || fail host_command_missing

run_storage_helper() {
  python3 - "$@" <<'PYTHON'
import os
import re
import stat
import sys


class StorageFailure(Exception):
    def __init__(self, code):
        self.code = code


def reject(code):
    raise StorageFailure(code)


directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
file_flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
opened_fds = []
attached_entries = []
absent_entries = []


def lstat_at(parent_fd, name, missing_code=None):
    try:
        return os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        if missing_code:
            reject(missing_code)
        return None
    except OSError:
        reject("storage_validation_failed")


def open_directory(
    parent_fd,
    name,
    invalid_code,
    owner_code,
    mode_code,
    expected_mode,
    uid,
    gid,
    *,
    optional=False,
    symlink_code=None,
    missing_code=None,
):
    details = lstat_at(parent_fd, name)
    if details is None:
        if optional:
            absent_entries.append((parent_fd, name))
            return None
        reject(missing_code or invalid_code)
    if stat.S_ISLNK(details.st_mode) and symlink_code:
        reject(symlink_code)
    if not stat.S_ISDIR(details.st_mode):
        reject(invalid_code)

    try:
        descriptor = os.open(name, directory_flags, dir_fd=parent_fd)
        opened = os.fstat(descriptor)
    except OSError:
        reject(invalid_code)
    opened_fds.append(descriptor)
    if (details.st_dev, details.st_ino) != (opened.st_dev, opened.st_ino):
        reject(invalid_code)
    if (opened.st_uid, opened.st_gid) != (uid, gid):
        reject(owner_code)
    if stat.S_IMODE(opened.st_mode) != expected_mode:
        reject(mode_code)
    attached_entries.append((parent_fd, name, descriptor, stat.S_ISDIR))
    return descriptor


def open_marker(bootstrap_fd, uid, gid):
    details = lstat_at(
        bootstrap_fd, ".layout-ready", "bootstrap_layout_not_ready"
    )
    if not stat.S_ISREG(details.st_mode):
        reject("layout_marker_invalid")
    try:
        descriptor = os.open(
            ".layout-ready", file_flags, dir_fd=bootstrap_fd
        )
        opened = os.fstat(descriptor)
    except OSError:
        reject("layout_marker_invalid")
    opened_fds.append(descriptor)
    if not stat.S_ISREG(opened.st_mode):
        reject("layout_marker_invalid")
    if (details.st_dev, details.st_ino) != (opened.st_dev, opened.st_ino):
        reject("layout_marker_invalid")
    if (opened.st_uid, opened.st_gid) != (uid, gid):
        reject("layout_marker_owner_invalid")
    if stat.S_IMODE(opened.st_mode) != 0o644:
        reject("layout_marker_mode_invalid")
    attached_entries.append(
        (bootstrap_fd, ".layout-ready", descriptor, stat.S_ISREG)
    )


def verify_stable_entries():
    for parent_fd, name in absent_entries:
        if lstat_at(parent_fd, name) is not None:
            reject("storage_layout_changed")

    for parent_fd, name, descriptor, type_check in attached_entries:
        details = lstat_at(parent_fd, name)
        if details is None or not type_check(details.st_mode):
            reject("storage_layout_changed")
        opened = os.fstat(descriptor)
        if (details.st_dev, details.st_ino) != (
            opened.st_dev,
            opened.st_ino,
        ):
            reject("storage_layout_changed")


try:
    if len(sys.argv) != 7:
        reject("invalid_preflight_arguments")
    runtime_root, app_name = sys.argv[1:3]
    root_uid, root_gid, app_uid, app_gid = map(int, sys.argv[3:])
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9_.-]*[A-Za-z0-9])?", app_name):
        reject("invalid_app_shared_root")

    try:
        srv_fd = os.open(runtime_root, directory_flags)
        srv_details = os.fstat(srv_fd)
    except OSError:
        reject("storage_runtime_invalid")
    opened_fds.append(srv_fd)
    if (srv_details.st_uid, srv_details.st_gid) != (root_uid, root_gid):
        reject("storage_runtime_owner_invalid")
    if stat.S_IMODE(srv_details.st_mode) != 0o755:
        reject("storage_runtime_mode_invalid")

    bootstrap_fd = open_directory(
        srv_fd,
        "bootstrap",
        "bootstrap_invalid",
        "bootstrap_owner_invalid",
        "bootstrap_mode_invalid",
        0o755,
        root_uid,
        root_gid,
    )
    open_marker(bootstrap_fd, root_uid, root_gid)
    apps_fd = open_directory(
        srv_fd,
        "apps",
        "apps_invalid",
        "apps_owner_invalid",
        "apps_mode_invalid",
        0o755,
        root_uid,
        root_gid,
    )
    app_fd = open_directory(
        apps_fd,
        app_name,
        "app_root_invalid",
        "app_root_owner_invalid",
        "app_root_mode_invalid",
        0o750,
        app_uid,
        app_gid,
        optional=True,
    )
    if app_fd is not None:
        shared_fd = open_directory(
            app_fd,
            "shared",
            "app_shared_root_invalid",
            "app_shared_root_owner_invalid",
            "app_shared_root_mode_invalid",
            0o750,
            app_uid,
            app_gid,
            optional=True,
            symlink_code="app_shared_root_symlink",
        )
        if shared_fd is not None:
            open_directory(
                shared_fd,
                "db",
                "app_shared_db_invalid",
                "app_shared_db_owner_invalid",
                "app_shared_db_mode_invalid",
                0o750,
                app_uid,
                app_gid,
                missing_code="app_shared_db_missing",
            )
    verify_stable_entries()
except StorageFailure as error:
    print(f"error={error.code}", file=sys.stderr)
    sys.exit(1)
except Exception:
    print("error=storage_validation_failed", file=sys.stderr)
    sys.exit(1)
finally:
    for descriptor in reversed(opened_fds):
        try:
            os.close(descriptor)
        except OSError:
            pass
PYTHON
}

run_storage_helper /srv "$app_name" 0 0 1000 1000

srv_source=$(findmnt -n -o SOURCE --target /srv) || fail srv_mount_source_unavailable
root_source=$(findmnt -n -o SOURCE --target /) || fail root_mount_source_unavailable
srv_device=$(stat -c '%d' -- /srv) || fail srv_device_unavailable
root_device=$(stat -c '%d' -- /) || fail root_device_unavailable
if [[ "$srv_source" == "$root_source" || "$srv_device" == "$root_device" ]]; then
  [[ "$allow_root_disk_storage" == '1' ]] || fail srv_not_separate_filesystem
  echo 'warning=root_disk_storage_enabled data_will_not_survive_server_loss' >&2
fi

listeners=$(ss -H -ltnp) || fail ingress_listener_inspection_failed
ingress_listeners=$(printf '%s\n' "$listeners" | awk '$4 ~ /:80$|:443$/ || $4 ~ /\]:80$|\]:443$/')

if [[ -n "$ingress_listeners" ]] && printf '%s\n' "$ingress_listeners" | grep -qv 'docker-proxy'; then
  fail foreign_ingress_listener
fi

containers=$(docker ps --format '{{.Names}}\t{{.Ports}}') || fail ingress_container_inspection_failed
ingress_containers=$(printf '%s\n' "$containers" | awk -F '\t' '$2 ~ /:80->|:443->/')

[[ -n "$ingress_listeners" && -z "$ingress_containers" ]] && fail foreign_ingress_listener

if [[ -n "$ingress_containers" ]]; then
  [[ $(printf '%s\n' "$ingress_containers" | wc -l | tr -d ' ') == '1' ]] || fail foreign_ingress_container
  container_name=$(printf '%s\n' "$ingress_containers" | cut -f1)
  container_ports=$(printf '%s\n' "$ingress_containers" | cut -f2-)
  [[ "$container_name" == 'kamal-proxy' ]] || fail foreign_ingress_container
  [[ "$container_ports" == *':80->'* && "$container_ports" == *':443->'* ]] || fail kamal_proxy_ports_invalid
fi
REMOTE
then
  grep -Fx \
    'warning=root_disk_storage_enabled data_will_not_survive_server_loss' \
    "$ssh_stderr" >&2 || true
else
  grep -E '^error=[a-z0-9_]+$' "$ssh_stderr" >&2 || true
  echo 'error=preflight_ssh_failed' >&2
  exit 1
fi
