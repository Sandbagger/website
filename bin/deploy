#!/usr/bin/env bash
# bin/deploy — Kamal wrapper for apps deployed onto the shared Hetzner host.
# Loads .env.deploy, asserts the shared-host contract vars are set, then delegates.
# Usage:  bin/deploy [staging] [kamal-subcommand ...]   (default: deploy)
set -euo pipefail

HERE=$(cd "$(dirname "$0")/.." && pwd)
destination=""

if [[ "${1:-}" == "staging" ]]; then
  destination="staging"
  shift
fi

if [[ -n "$destination" ]]; then
  default_env_file="$HERE/.env.deploy.$destination"
  handoff_service=website-staging
  expected_shared_root=/srv/apps/website-staging/shared
else
  default_env_file="$HERE/.env.deploy"
  handoff_service=website
  expected_shared_root=/srv/apps/website/shared
fi

ENV_FILE="${DEPLOY_ENV_FILE:-$default_env_file}"

if [[ ! -f $ENV_FILE ]]; then
  echo "error=missing_env_file path=$ENV_FILE" >&2
  echo "hint=dotfiles-hetzner-tf handoff $handoff_service --format env > $default_env_file" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

required=(KAMAL_HOST APP_SHARED_ROOT)
missing=()
for var in "${required[@]}"; do
  if [[ -z "${!var:-}" ]]; then
    missing+=("$var")
  fi
done
if (( ${#missing[@]} > 0 )); then
  echo "error=missing_vars vars=${missing[*]}" >&2
  echo "hint=edit $ENV_FILE in place; do not regenerate or overwrite it" >&2
  exit 2
fi

if [[ "$APP_SHARED_ROOT" != "$expected_shared_root" ]]; then
  echo "error=unexpected_app_shared_root expected=$expected_shared_root" >&2
  exit 2
fi

"$HERE/bin/deploy-preflight"

if ! bundle exec kamal version >/dev/null 2>&1; then
  echo "error=kamal_not_found" >&2
  echo "hint=bundle install (kamal is a development Gemfile dep)" >&2
  exit 3
fi

if (( $# == 0 )); then
  set -- deploy
fi

if [[ -n "$destination" ]]; then
  exec bundle exec kamal -d "$destination" "$@"
else
  exec bundle exec kamal "$@"
fi
