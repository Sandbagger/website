#!/usr/bin/env bash
# bin/deploy — Kamal wrapper for apps deployed onto the shared Hetzner host.
# Loads .env.deploy, asserts the shared-host contract vars are set, then delegates.
# Usage:  bin/deploy [kamal-subcommand ...]   (default: deploy)
set -euo pipefail

HERE=$(cd "$(dirname "$0")/.." && pwd)
ENV_FILE=$HERE/.env.deploy

if [[ ! -f $ENV_FILE ]]; then
  echo "error=missing_env_file path=$ENV_FILE" >&2
  echo "hint=dotfiles-hetzner-tf handoff website --format env > .env.deploy" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

required=(KAMAL_HOST APP_SHARED_ROOT)
missing=()
for var in "${required[@]}"; do
  if [[ -z "${!var:-}" ]]; then
    missing+=("$var")
  fi
done
if (( ${#missing[@]} > 0 )); then
  echo "error=missing_vars vars=${missing[*]}" >&2
  echo "hint=regenerate .env.deploy with dotfiles-hetzner-tf handoff website --format env" >&2
  exit 2
fi

if ! bundle exec kamal version >/dev/null 2>&1; then
  echo "error=kamal_not_found" >&2
  echo "hint=bundle install (kamal is a development Gemfile dep)" >&2
  exit 3
fi

exec bundle exec kamal "${@:-deploy}"
