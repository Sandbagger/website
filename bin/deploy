#!/usr/bin/env bash
# bin/deploy — Kamal wrapper for apps deployed onto the shared Hetzner host.
# Loads .env.deploy, asserts the shared-host contract vars are set, then delegates.
# Usage:  bin/deploy [staging] [kamal-subcommand ...]   (default: deploy)
set -euo pipefail

DEPLOY_WRAPPER_ROOT=$(cd "$(dirname "$0")/.." && pwd)
readonly DEPLOY_WRAPPER_ROOT
DEPLOY_WRAPPER_DESTINATION=

if [[ "${1:-}" == "staging" ]]; then
  DEPLOY_WRAPPER_DESTINATION=staging
  shift
fi
readonly DEPLOY_WRAPPER_DESTINATION

for deploy_wrapper_argument in "$@"; do
  case "$deploy_wrapper_argument" in
    -d|-d?*|--destination|--destination=*|\
    -c|-c?*|--config-file|--config-file=*|\
    -H|--skip-hooks|--skip-hooks=*)
      printf 'error=unsupported_kamal_option option=%s\n' \
        "$deploy_wrapper_argument" >&2
      exit 1
      ;;
  esac
done

if [[ -n "$DEPLOY_WRAPPER_DESTINATION" ]]; then
  DEPLOY_WRAPPER_DEFAULT_ENV_FILE="$DEPLOY_WRAPPER_ROOT/.env.deploy.staging"
  DEPLOY_WRAPPER_HANDOFF_SERVICE=website-staging
  DEPLOY_WRAPPER_EXPECTED_SHARED_ROOT=/srv/apps/website-staging/shared
else
  DEPLOY_WRAPPER_DEFAULT_ENV_FILE="$DEPLOY_WRAPPER_ROOT/.env.deploy"
  DEPLOY_WRAPPER_HANDOFF_SERVICE=website
  DEPLOY_WRAPPER_EXPECTED_SHARED_ROOT=/srv/apps/website/shared
fi
readonly DEPLOY_WRAPPER_DEFAULT_ENV_FILE
readonly DEPLOY_WRAPPER_HANDOFF_SERVICE
readonly DEPLOY_WRAPPER_EXPECTED_SHARED_ROOT

DEPLOY_WRAPPER_ENV_PATH="${DEPLOY_ENV_FILE:-$DEPLOY_WRAPPER_DEFAULT_ENV_FILE}"
readonly DEPLOY_WRAPPER_ENV_PATH

if [[ ! -f $DEPLOY_WRAPPER_ENV_PATH ]]; then
  echo "error=missing_env_file path=$DEPLOY_WRAPPER_ENV_PATH" >&2
  echo "hint=dotfiles-hetzner-tf handoff $DEPLOY_WRAPPER_HANDOFF_SERVICE --format env > $DEPLOY_WRAPPER_DEFAULT_ENV_FILE" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$DEPLOY_WRAPPER_ENV_PATH"
set +a

required_vars=(KAMAL_HOST APP_SHARED_ROOT)
missing_vars=()
for required_var in "${required_vars[@]}"; do
  if [[ -z "${!required_var:-}" ]]; then
    missing_vars+=("$required_var")
  fi
done
if (( ${#missing_vars[@]} > 0 )); then
  echo "error=missing_vars vars=${missing_vars[*]}" >&2
  echo "hint=edit $DEPLOY_WRAPPER_ENV_PATH in place; do not regenerate or overwrite it" >&2
  exit 2
fi

if [[ "$APP_SHARED_ROOT" != "$DEPLOY_WRAPPER_EXPECTED_SHARED_ROOT" ]]; then
  echo "error=unexpected_app_shared_root expected=$DEPLOY_WRAPPER_EXPECTED_SHARED_ROOT" >&2
  exit 2
fi

"$DEPLOY_WRAPPER_ROOT/bin/deploy-preflight"

if ! bundle exec kamal version >/dev/null 2>&1; then
  echo "error=kamal_not_found" >&2
  echo "hint=bundle install (kamal is a development Gemfile dep)" >&2
  exit 3
fi

if (( $# == 0 )); then
  set -- deploy
fi

if [[ -n "$DEPLOY_WRAPPER_DESTINATION" ]]; then
  exec bundle exec kamal -d "$DEPLOY_WRAPPER_DESTINATION" "$@"
else
  exec bundle exec kamal "$@"
fi
