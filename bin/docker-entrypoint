#!/usr/bin/env bash
set -euo pipefail

if [[ -z ${LITESTREAM_READY_MARKER+x} ]]; then
  export LITESTREAM_READY_MARKER=/rails/storage/.web-ready
fi

# Prepare the SQLite database on the web role's boot only.
# Other roles (e.g. litestream) share the same volume and must not race.
if [[ ${1:-} == "./bin/rails" && ${2:-} == "server" ]]; then
  rm -f "$LITESTREAM_READY_MARKER"
  ./bin/rails db:prepare

  journal_mode=$(./bin/rails runner "puts ActiveRecord::Base.connection.select_value('PRAGMA journal_mode')" | tail -n 1)
  if [[ $journal_mode != "wal" ]]; then
    echo "error=sqlite_not_wal journal_mode=$journal_mode" >&2
    exit 1
  fi

  install -m 0640 /dev/null "$LITESTREAM_READY_MARKER"
fi

exec "${@}"
