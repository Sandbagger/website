#!/usr/bin/env bash
# Prepare an existing Ubuntu 22.04 host for durable Kamal application storage.
set -euo pipefail

if [[ -z "${KAMAL_HOST:-}" ]]; then
  echo 'error=missing_kamal_host' >&2
  exit 1
fi

if [[ -z "${APP_SHARED_ROOT:-}" ]]; then
  echo 'error=missing_app_shared_root' >&2
  exit 1
fi

if [[ ! "$APP_SHARED_ROOT" =~ ^/srv/apps/[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?/shared$ ]]; then
  echo 'error=invalid_app_shared_root' >&2
  exit 1
fi

app_name=${APP_SHARED_ROOT#/srv/apps/}
app_name=${app_name%/shared}

allow_root_disk_storage=0
if [[ "${ALLOW_ROOT_DISK_STORAGE:-}" == 1 ]]; then
  allow_root_disk_storage=1
fi

ssh "root@$KAMAL_HOST" bash -s -- \
  "$APP_SHARED_ROOT" "$allow_root_disk_storage" <<'REMOTE'
set -euo pipefail

fail() {
  echo "error=$1" >&2
  exit 1
}

[[ $# == 2 ]] || fail invalid_bootstrap_arguments
app_shared_root=$1
allow_root_disk_storage=$2
[[ "$app_shared_root" =~ ^/srv/apps/[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?/shared$ ]] ||
  fail invalid_app_shared_root
[[ "$allow_root_disk_storage" == 0 || "$allow_root_disk_storage" == 1 ]] ||
  fail invalid_root_disk_storage
app_root=${app_shared_root%/shared}
app_name=${app_root##*/}
backup_root=/srv/backups
app_backup_root="$backup_root/$app_name"
layout_marker=/srv/bootstrap/.layout-ready

srv_source=$(findmnt -n -o SOURCE --target /srv) ||
  fail srv_mount_source_unavailable
root_source=$(findmnt -n -o SOURCE --target /) ||
  fail root_mount_source_unavailable
if [[ "$srv_source" == "$root_source" ]]; then
  [[ "$allow_root_disk_storage" == 1 ]] ||
    fail srv_not_separate_filesystem
  echo 'warning=root_disk_storage_enabled data_will_not_survive_server_loss' >&2
fi

source /etc/os-release || fail unsupported_host_os
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == 22.04 ]] ||
  fail unsupported_host_os
command -v apt-get >/dev/null 2>&1 || fail host_command_missing
command -v systemctl >/dev/null 2>&1 || fail host_command_missing
command -v python3 >/dev/null 2>&1 || fail host_command_missing

managed_directories=(
  /srv/bootstrap
  /srv/apps
  "$app_root"
  "$app_shared_root"
  "$app_shared_root/db"
  "$backup_root"
  "$app_backup_root"
)

for path in "${managed_directories[@]}"; do
  test -L "$path" && fail managed_path_invalid
  if test -e "$path"; then
    test -d "$path" || fail managed_path_invalid
  fi
done

test -L "$layout_marker" && fail layout_marker_invalid
if test -e "$layout_marker"; then
  test -f "$layout_marker" || fail layout_marker_invalid
fi

run_layout_helper() {
  python3 - "$@" <<'PYTHON'
import os
import secrets
import stat
import sys


class BootstrapFailure(Exception):
    def __init__(self, code):
        self.code = code


def reject(code):
    raise BootstrapFailure(code)


directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
opened_fds = []
attached_directories = []
bootstrap_fd = None
marker_fd = None
marker_temp = None
marker_published = False
bootstrap_complete = False


def open_directory(parent_fd, name, mode, uid, gid):
    try:
        os.mkdir(name, mode=mode, dir_fd=parent_fd)
    except FileExistsError:
        pass
    except OSError:
        reject("layout_creation_failed")

    try:
        child_fd = os.open(name, directory_flags, dir_fd=parent_fd)
    except OSError:
        reject("managed_path_invalid")

    opened_fds.append(child_fd)
    try:
        os.fchown(child_fd, uid, gid)
        os.fchmod(child_fd, mode)
        details = os.fstat(child_fd)
    except OSError:
        reject("layout_configuration_failed")

    if not stat.S_ISDIR(details.st_mode):
        reject("managed_path_invalid")
    if stat.S_IMODE(details.st_mode) != mode:
        reject("layout_mode_invalid")
    if (details.st_uid, details.st_gid) != (uid, gid):
        reject("layout_owner_invalid")

    attached_directories.append((parent_fd, name, child_fd))
    return child_fd


def verify_attached_directories():
    for parent_fd, name, child_fd in attached_directories:
        try:
            linked = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
            opened = os.fstat(child_fd)
        except OSError:
            reject("managed_path_invalid")

        if not stat.S_ISDIR(linked.st_mode):
            reject("managed_path_invalid")
        if (linked.st_dev, linked.st_ino) != (opened.st_dev, opened.st_ino):
            reject("managed_path_invalid")


def validate_existing_marker(parent_fd):
    try:
        details = os.stat(
            ".layout-ready", dir_fd=parent_fd, follow_symlinks=False
        )
    except FileNotFoundError:
        return
    except OSError:
        reject("layout_marker_invalid")

    if not stat.S_ISREG(details.st_mode):
        reject("layout_marker_invalid")


try:
    if len(sys.argv) != 8:
        reject("invalid_bootstrap_arguments")
    operation = sys.argv[1]
    runtime_root = sys.argv[2]
    app_name = sys.argv[3]
    root_uid, root_gid, app_uid, app_gid = map(int, sys.argv[4:])
    if operation not in ("invalidate", "configure"):
        reject("invalid_bootstrap_arguments")

    try:
        srv_fd = os.open(runtime_root, directory_flags)
    except OSError:
        reject("managed_path_invalid")
    opened_fds.append(srv_fd)

    if operation == "invalidate":
        try:
            bootstrap_fd = os.open(
                "bootstrap", directory_flags, dir_fd=srv_fd
            )
        except FileNotFoundError:
            sys.exit(0)
        except OSError:
            reject("managed_path_invalid")
        opened_fds.append(bootstrap_fd)
        validate_existing_marker(bootstrap_fd)
        try:
            os.unlink(".layout-ready", dir_fd=bootstrap_fd)
        except FileNotFoundError:
            pass
        os.fsync(bootstrap_fd)
        sys.exit(0)

    bootstrap_fd = open_directory(
        srv_fd, "bootstrap", 0o755, root_uid, root_gid
    )
    validate_existing_marker(bootstrap_fd)
    apps_fd = open_directory(srv_fd, "apps", 0o755, root_uid, root_gid)
    backups_fd = open_directory(
        srv_fd, "backups", 0o755, root_uid, root_gid
    )
    app_fd = open_directory(
        apps_fd, app_name, 0o750, app_uid, app_gid
    )
    shared_fd = open_directory(
        app_fd, "shared", 0o750, app_uid, app_gid
    )
    open_directory(shared_fd, "db", 0o750, app_uid, app_gid)
    open_directory(
        backups_fd, app_name, 0o750, root_uid, root_gid
    )
    verify_attached_directories()

    marker_temp = f".layout-ready.tmp.{os.getpid()}.{secrets.token_hex(8)}"
    marker_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    marker_fd = os.open(
        marker_temp, marker_flags, 0o600, dir_fd=bootstrap_fd
    )
    os.fchown(marker_fd, root_uid, root_gid)
    os.fchmod(marker_fd, 0o644)
    marker_details = os.fstat(marker_fd)
    if not stat.S_ISREG(marker_details.st_mode):
        reject("layout_marker_invalid")
    if stat.S_IMODE(marker_details.st_mode) != 0o644:
        reject("layout_marker_mode_invalid")
    if (marker_details.st_uid, marker_details.st_gid) != (
        root_uid,
        root_gid,
    ):
        reject("layout_marker_owner_invalid")
    os.fsync(marker_fd)
    os.close(marker_fd)
    marker_fd = None

    verify_attached_directories()
    os.rename(
        marker_temp,
        ".layout-ready",
        src_dir_fd=bootstrap_fd,
        dst_dir_fd=bootstrap_fd,
    )
    marker_temp = None
    marker_published = True
    os.fsync(bootstrap_fd)
    bootstrap_complete = True
except BootstrapFailure as error:
    print(f"error={error.code}", file=sys.stderr)
    sys.exit(1)
except (IndexError, OSError):
    print("error=layout_operation_failed", file=sys.stderr)
    sys.exit(1)
finally:
    if marker_fd is not None:
        os.close(marker_fd)
    if marker_temp is not None and bootstrap_fd is not None:
        try:
            os.unlink(marker_temp, dir_fd=bootstrap_fd)
        except FileNotFoundError:
            pass
    if (
        marker_published
        and not bootstrap_complete
        and bootstrap_fd is not None
    ):
        try:
            os.unlink(".layout-ready", dir_fd=bootstrap_fd)
            os.fsync(bootstrap_fd)
        except OSError:
            pass
    for descriptor in reversed(opened_fds):
        try:
            os.close(descriptor)
        except OSError:
            pass
PYTHON
}

run_layout_helper invalidate /srv "$app_name" 0 0 1000 1000

if ! command -v docker >/dev/null 2>&1; then
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io
fi

systemctl enable --now docker
docker info >/dev/null

run_layout_helper configure /srv "$app_name" 0 0 1000 1000

echo 'host_bootstrap=ready'
echo 'next=bin/setup-kamal'
REMOTE
