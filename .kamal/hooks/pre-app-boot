#!/usr/bin/env bash
set -euo pipefail

: "${KAMAL_HOST:?missing KAMAL_HOST}"
: "${APP_SHARED_ROOT:?missing APP_SHARED_ROOT}"

if [[ ! "$APP_SHARED_ROOT" =~ ^/srv/apps/[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?/shared$ ]]; then
  echo 'error=invalid_app_shared_root' >&2
  exit 1
fi

env -u KAMAL_REGISTRY_PASSWORD -u RAILS_MASTER_KEY \
  ssh "root@$KAMAL_HOST" bash -s -- "$APP_SHARED_ROOT" <<'REMOTE'
set -euo pipefail

fail() {
  echo "error=$1" >&2
  exit 1
}

[[ $# == 1 ]] || fail invalid_pre_app_arguments
app_shared_root=$1
[[ "$app_shared_root" =~ ^/srv/apps/[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?/shared$ ]] ||
  fail invalid_app_shared_root
app_root=${app_shared_root%/shared}
app_name=${app_root##*/}

run_app_layout_helper() {
  python3 - "$@" <<'PYTHON'
import os
import re
import stat
import sys


class LayoutFailure(Exception):
    def __init__(self, code):
        self.code = code


def reject(code):
    raise LayoutFailure(code)


directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
opened_fds = []
attached_directories = []


def open_existing_directory(parent_fd, name):
    try:
        descriptor = os.open(name, directory_flags, dir_fd=parent_fd)
    except OSError:
        reject("managed_path_invalid")
    opened_fds.append(descriptor)
    return descriptor


def open_directory(parent_fd, name, mode, uid, gid):
    try:
        os.mkdir(name, mode=mode, dir_fd=parent_fd)
    except FileExistsError:
        pass
    except OSError:
        reject("layout_creation_failed")

    descriptor = open_existing_directory(parent_fd, name)
    try:
        os.fchown(descriptor, uid, gid)
        os.fchmod(descriptor, mode)
        details = os.fstat(descriptor)
    except OSError:
        reject("layout_configuration_failed")

    if not stat.S_ISDIR(details.st_mode):
        reject("managed_path_invalid")
    if stat.S_IMODE(details.st_mode) != mode:
        reject("layout_mode_invalid")
    if (details.st_uid, details.st_gid) != (uid, gid):
        reject("layout_owner_invalid")

    attached_directories.append((parent_fd, name, descriptor))
    return descriptor


def verify_attached_directories():
    for parent_fd, name, descriptor in attached_directories:
        try:
            linked = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
            opened = os.fstat(descriptor)
        except OSError:
            reject("managed_path_invalid")
        if not stat.S_ISDIR(linked.st_mode):
            reject("managed_path_invalid")
        if (linked.st_dev, linked.st_ino) != (opened.st_dev, opened.st_ino):
            reject("managed_path_invalid")


try:
    if len(sys.argv) != 5:
        reject("invalid_pre_app_arguments")
    runtime_root, app_name = sys.argv[1:3]
    uid, gid = map(int, sys.argv[3:])
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9_.-]*[A-Za-z0-9])?", app_name):
        reject("invalid_app_shared_root")

    try:
        srv_fd = os.open(runtime_root, directory_flags)
    except OSError:
        reject("managed_path_invalid")
    opened_fds.append(srv_fd)

    apps_fd = open_existing_directory(srv_fd, "apps")
    app_fd = open_directory(apps_fd, app_name, 0o750, uid, gid)
    shared_fd = open_directory(app_fd, "shared", 0o750, uid, gid)
    open_directory(shared_fd, "db", 0o750, uid, gid)
    verify_attached_directories()
except LayoutFailure as error:
    print(f"error={error.code}", file=sys.stderr)
    sys.exit(1)
except (OSError, ValueError):
    print("error=layout_operation_failed", file=sys.stderr)
    sys.exit(1)
finally:
    for descriptor in reversed(opened_fds):
        try:
            os.close(descriptor)
        except OSError:
            pass
PYTHON
}

run_app_layout_helper /srv "$app_name" 1000 1000
REMOTE
