# Staging values — populate before running `bin/deploy staging`.
# Generate the shared-host values with:
#   dotfiles-hetzner-tf handoff website-staging --format env > .env.deploy.staging

KAMAL_HOST=shared-kamal-01
APP_SHARED_ROOT=/srv/apps/website-staging/shared

# Keep staging secrets separate from production. In particular, use a distinct
# Litestream prefix such as s3://bucket/website-staging.
KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
