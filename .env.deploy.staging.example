# Staging values — populate before running `bin/deploy staging`. The same
# durable-host preflight applies; use only the staging app root below.
# Generate the shared-host values with:
#   dotfiles-hetzner-tf handoff website-staging --format env > .env.deploy.staging

KAMAL_HOST=shared-kamal-01
APP_SHARED_ROOT=/srv/apps/website-staging/shared

# Keep staging secrets separate from production.
KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=
