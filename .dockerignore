# Version control
.git
.gitattributes
.github

# Rails credential keys are runtime secrets, never build inputs.
config/master.key
config/credentials/*.key

# Deploy scaffolding never travels into the image.
.kamal
.env
.env.*
!.env.deploy.example
.deploy-scaffold.json

# Local production smoke test stays on the host.
bin/run-production-image

# Dev servers + editor state
.tmuxp.yml
.yarn
.vscode
.idea

# Build artefacts (regenerated in the image)
node_modules
app/assets/builds/*
!app/assets/builds/.keep
public/assets
public/packs

# Runtime state (never ship dev DB or logs)
storage/*
!storage/.keep
log/*
!log/.keep
tmp/*
!tmp/.keep

# Tests (not needed at runtime)
test
coverage

# Docs — deploy image doesn't need them
docs
README.md
LICENSE

# Procfile.dev is foreman-local; Procfile is kept for local process tools.
Procfile.dev
