# hetzner-basic handoff values — populate before running bin/deploy.
#
# Generate the shared-host values with:
#   dotfiles-hetzner-tf handoff website --format env > .env.deploy
#
# Preflight contract: /srv/bootstrap/.layout-ready and the documented
# APP_SHARED_ROOT are required. A separate /srv mount is the default; root-disk
# /srv is allowed only with the exact ALLOW_ROOT_DISK_STORAGE=1 opt-in.
# See docs/DEPLOY.md. Do not place values for blank secrets in this file.

KAMAL_HOST=shared-kamal-01
APP_SHARED_ROOT=/srv/apps/website/shared

# Keep 0 for a separate durable /srv mount. Set exactly 1 only when accepting
# that app data is stored on, and lost with, the server root disk.
ALLOW_ROOT_DISK_STORAGE=0

# Kamal registry + Rails secret — pull from 1Password at deploy time, do not commit.
KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=
